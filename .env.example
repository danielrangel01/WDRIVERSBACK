# Railway — variables OBLIGATORIAS (definir en Railway Dashboard)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/flotamanager?retryWrites=true&w=majority
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_MINIMO_32_CARACTERES_ALEATORIOS_abc123
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEst0PorUnaContraseñaFuerte!123

# Origen del frontend en producción (Netlify o dominio propio). SIN barra al final.
# Para múltiples orígenes sepáralos por coma: https://a.app,https://b.app
CLIENT_ORIGIN=https://tu-app.netlify.app

# Variables OPCIONALES
NODE_ENV=production
PORT=4000
JWT_EXPIRES_IN=12h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_MAX=8
PAYLOAD_LIMIT=100kb

# Pasos para crear admin después del deploy en Railway:
# 1. Ve a tu servicio → Workloads → Click en la versión deployeada
# 2. Abrir pestaña "Service Variables" y confirmar ADMIN_USER / ADMIN_PASSWORD
# 3. Ir a la pestaña "Jobs" → "Run Job" o bien ejecutar localmente conectado a la misma DB:
#        cd server && npm run seed
#    o vía Railway shell (si está disponible):
#        npm run seed
