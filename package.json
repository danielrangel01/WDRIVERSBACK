{
  "name": "wdrivers-server",
  "version": "2.1.0",
  "description": "Backend W Drivers — Clean Architecture (Express + MongoDB)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "seed": "node src/seed.js",
    "create-admin": "node src/seed.js",
    "migrate": "node migrate.js",
    "migrate:apply": "node migrate.js --apply",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
  },
  "vitest": {
    "test": {
      "include": [
        "tests/**/*.test.js",
        "**/*.test.js"
      ]
    }
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
